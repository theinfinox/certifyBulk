{
  "id": "https://certify.govindsr.me/",
  "name": "CertifyBulk - High-Resolution Bulk Certificate Generator",
  "short_name": "CertifyBulk",
  "description": "Lightning-fast, entirely client-side PWA for generating mass high-resolution certificates locally using dynamic CSV data mappings.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8f9fa",
  "theme_color": "#0d0d0d",
  "dir": "ltr",
  "lang": "en-US",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ec4e53b7",
  "categories": [
    "productivity",
    "utilities",
    "graphics"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "windows",
      "id": "theinfinox.CertifyBulk",
      "url": "https://apps.microsoft.com/detail/theinfinox.CertifyBulk"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "scope_extensions": [
    {
      "origin": "https://certify.govindsr.me"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "CSV Spreadsheet",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+certify",
      "url": "/?cert=%s"
    }
  ],
  "icons": [
